# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin auth
# Generate a bcrypt hash of your admin password (see README) and paste it here.
# Never commit the real value — this is a template.
ADMIN_PASSWORD_HASH=$2a$10$replace-with-a-bcrypt-hash
ADMIN_USERNAME=admin

# Random 32+ char secret used to sign the admin session cookie
SESSION_SECRET=replace-with-a-long-random-string
